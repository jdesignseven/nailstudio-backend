generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?
  password      String
  role          String         @default("PROFESSIONAL")
  studioId      String?
  studio        Studio?        @relation(fields: [studioId], references: [id])
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Studio {
  id           String       @id @default(cuid())
  name         String
  phone        String?
  address      String?
  logoUrl      String?
  customPage   Boolean      @default(false)
  pixKey       String?
  users        User[]
  clients      Client[]
  services     Service[]
  appointments Appointment[]
  expenses     Expense[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Client {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  email         String?
  photoUrl      String?
  notes         String?
  anamnesis     Anamnesis?
  studioId      String
  studio        Studio         @relation(fields: [studioId], references: [id])
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Anamnesis {
  id          String   @id @default(cuid())
  clientId    String   @unique
  client      Client   @relation(fields: [clientId], references: [id])
  allergies   String?
  conditions  String?
  medications String?
  pregnant    Boolean?
  diabetes    Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    Int
  category    String?
  photoUrl    String?
  active      Boolean        @default(true)
  studioId    String
  studio      Studio         @relation(fields: [studioId], references: [id])
  appointments Appointment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  description String
  amount    Float
  category  String   @default("Operacionais")
  date      DateTime
  notes     String?
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id            String   @id @default(cuid())
  date          DateTime
  status        String   @default("scheduled")
  notes         String?
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  studioId      String
  studio        Studio   @relation(fields: [studioId], references: [id])
  depositPaid   Boolean  @default(false)
  depositAmount Float?
  totalPaid     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
